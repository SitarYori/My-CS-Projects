<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 订单号 + 状态 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_order_no"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="订单号：BK20260624123456"
                android:textSize="12sp"
                android:textColor="#666666" />

            <TextView
                android:id="@+id/tv_order_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="待付款"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#FF9800" />

            <!-- ⭐ 已评价标签 -->
            <TextView
                android:id="@+id/tv_review_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="已评价"
                android:textSize="10sp"
                android:textColor="#4CAF50"
                android:background="#E8F5E9"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="8dp"
                android:visibility="gone" />

        </LinearLayout>

        <!-- 分割线 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginTop="8dp" />

        <!-- 商品信息 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_order_product_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="鲜朗烘焙全期全价猫粮2kg"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:id="@+id/tv_order_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="¥168"
                        android:textSize="14sp"
                        android:textColor="#FF6B35" />

                    <TextView
                        android:id="@+id/tv_order_quantity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="×1"
                        android:textSize="13sp"
                        android:textColor="#666666"
                        android:layout_marginStart="8dp" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_order_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥168.00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF6B35" />

        </LinearLayout>

        <!-- 时间 -->
        <TextView
            android:id="@+id/tv_order_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-06-24 12:34:56"
            android:textSize="11sp"
            android:textColor="#999999"
            android:layout_marginTop="6dp" />

        <!-- ⭐ 底部操作栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <!-- ⭐ 删除按钮（已完成/已取消显示） -->
            <TextView
                android:id="@+id/btn_delete_order"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="删除订单"
                android:textSize="12sp"
                android:textColor="#FF3B30"
                android:background="@drawable/bg_outline_btn"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone" />

            <!-- 占位 -->
            <View
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <!-- 查看详情 -->
            <TextView
                android:id="@+id/btn_view_detail"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:text="查看详情"
                android:textSize="12sp"
                android:textColor="#4A90D9"
                android:background="@drawable/bg_outline_btn"
                android:paddingHorizontal="16dp"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>