<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="宠物寄养"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />

    </LinearLayout>

    <!-- 表单 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 宠物名称 -->
            <EditText
                android:id="@+id/et_pet_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:hint="宠物名称"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textColorHint="#B0B0B0" />

            <!-- 宠物类型 -->
            <EditText
                android:id="@+id/et_pet_type"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:hint="宠物类型（如：金毛、布偶猫）"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textColorHint="#B0B0B0"
                android:layout_marginTop="16dp" />

            <!-- 服务项目 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择服务项目"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:id="@+id/ll_services"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp" />

            <!-- 预约日期 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预约日期"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/et_date"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:hint="请选择日期"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textColorHint="#B0B0B0"
                android:focusable="false"
                android:clickable="true"
                android:layout_marginTop="8dp" />

            <!-- 预约时间 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="预约时间"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/tv_time_am"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="上午 (09:00-12:00)"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:background="@drawable/bg_spec_normal"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tv_time_pm"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="下午 (14:00-18:00)"
                    android:gravity="center"
                    android:textSize="13sp"
                    android:textColor="#333333"
                    android:background="@drawable/bg_spec_normal"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- 地址 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="上门地址"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/et_address"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:hint="请输入上门地址"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textColorHint="#B0B0B0"
                android:layout_marginTop="8dp" />

            <!-- 备注 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="备注（选填）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#333333"
                android:layout_marginTop="16dp" />

            <EditText
                android:id="@+id/et_remark"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="16dp"
                android:paddingTop="12dp"
                android:hint="特殊要求或注意事项"
                android:textSize="15sp"
                android:textColor="#333333"
                android:textColorHint="#B0B0B0"
                android:gravity="top"
                android:layout_marginTop="8dp" />

        </LinearLayout>

    </ScrollView>

    <!-- 提交按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#FFFFFF"
        android:paddingHorizontal="16dp"
        android:gravity="center"
        android:elevation="8dp">

        <Button
            android:id="@+id/btn_submit"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_buy_btn"
            android:text="提交预约"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>

</LinearLayout>