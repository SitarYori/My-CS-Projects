<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="12dp"
    android:layout_marginBottom="0dp">

    <!-- ⭐ 商品图片 -->
    <ImageView
        android:id="@+id/iv_product_image"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:scaleType="centerCrop"
        android:background="#F5F6FA" />

    <!-- 商品名称 -->
    <TextView
        android:id="@+id/tv_product_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="鲜朗烘焙全期全价猫粮2..."
        android:textSize="13sp"
        android:textColor="#333333"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginTop="8dp" />

    <!-- 商品描述 -->
    <TextView
        android:id="@+id/tv_product_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="61%鲜鸡肉+20%鲜骨鸡肉"
        android:textSize="11sp"
        android:textColor="#999999"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- 标签（如：免疫加持 高效吸收） -->
    <TextView
        android:id="@+id/tv_product_tags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="免疫加持 高效吸收"
        android:textSize="10sp"
        android:textColor="#4A90D9"
        android:background="#F0F4FF"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:layout_marginTop="4dp"
        android:visibility="gone" />

    <!-- 销量 -->
    <TextView
        android:id="@+id/tv_sales"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="销量0"
        android:textSize="10sp"
        android:textColor="#CCCCCC"
        android:layout_marginTop="4dp" />

    <!-- 价格 + 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥168"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FF6B35" />

            <TextView
                android:id="@+id/tv_original_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¥99"
                android:textSize="11sp"
                android:textColor="#CCCCCC"
                android:paddingStart="6dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/btn_spec"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="选规格"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_spec"
            android:paddingHorizontal="14dp"
            android:paddingVertical="4dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>