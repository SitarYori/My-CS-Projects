<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F6FA">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FFFFFF"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:elevation="4dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_back"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="我的券包"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:gravity="center" />

        <View
            android:layout_width="32dp"
            android:layout_height="32dp" />

    </LinearLayout>

    <!-- 统计信息 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/tv_unused_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0张可用"
            android:textSize="14sp"
            android:textColor="#4A90D9"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/tv_used_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0张已用"
            android:textSize="14sp"
            android:textColor="#666666"
            android:gravity="center" />

        <View
            android:layout_width="1dp"
            android:layout_height="20dp"
            android:background="#EEEEEE" />

        <TextView
            android:id="@+id/tv_expired_count"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0张过期"
            android:textSize="14sp"
            android:textColor="#999999"
            android:gravity="center" />

    </LinearLayout>

    <!-- Tab切换 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="2dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tab_unused"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="未使用"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#4A90D9"
            android:background="@drawable/bg_tab_selected" />

        <TextView
            android:id="@+id/tab_used"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="已使用"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#666666"
            android:background="@drawable/bg_tab_normal" />

        <TextView
            android:id="@+id/tab_expired"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="已过期"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="#666666"
            android:background="@drawable/bg_tab_normal" />

    </LinearLayout>

    <!-- 空状态 -->
    <LinearLayout
        android:id="@+id/ll_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="🎫"
            android:textSize="48sp"
            android:gravity="center"
            android:background="@drawable/bg_empty_cart" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="暂无优惠券"
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="去参与活动领取吧～"
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- 优惠券列表 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_coupons"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="12dp"
        android:visibility="gone" />

</LinearLayout>